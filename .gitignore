# Build output / local executables - never commit these
dist/
build/
*.spec
*.exe

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Local secrets. The real key lives in ~/.orfree/config.json (outside the repo),
# but keep a guard here in case someone puts a copy next to the source.
.orfree/
config.json
api_key*.txt
*.key
.env

# Daily snapshots generated by "list --snapshot" / "daily"
*.snapshot.json
